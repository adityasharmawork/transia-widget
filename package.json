{
  "name": "transia-widget",
  "version": "0.1.0",
  "description": "Floating language switcher widget for Transia-powered multilingual websites",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./next-intl": {
      "types": "./dist/frameworks/next-intl.d.ts",
      "import": "./dist/frameworks/next-intl.js",
      "require": "./dist/frameworks/next-intl.cjs",
      "default": "./dist/frameworks/next-intl.js"
    },
    "./i18next": {
      "types": "./dist/frameworks/i18next.d.ts",
      "import": "./dist/frameworks/i18next.js",
      "require": "./dist/frameworks/i18next.cjs",
      "default": "./dist/frameworks/i18next.js"
    }
  },
  "files": [
    "dist"
  ],
  "author": "Transia",
  "homepage": "https://transia.dev/docs#widget",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^30.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "keywords": [
    "transia",
    "i18n",
    "translation",
    "language-switcher",
    "widget",
    "react",
    "next-intl",
    "i18next"
  ],
  "license": "MIT"
}
